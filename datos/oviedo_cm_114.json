  "fuente": "Alejandro Oviedo, 'Un estudio sobre la estructura de las senas de la Lengua de Senas Venezolana', Universidad de Los Andes, Merida, 2000 (rev. 2003), Parte 1: inventario de las 114 configuraciones manuales observadas en la LSV.",
  "convenciones": {
    "+": "abierto (las tres articulaciones extendidas)",
    "-": "cerrado (las tres articulaciones flexionadas)",
    "^": "aplanado (metacarpo-proximal extendida, las otras dos flexionadas)",
    "\"": "arqueado (metacarpo-proximal y medio-distal extendidas, proxima-media flexionada)",
    "d+": "diacritico: articulacion distal extendida",
    "d-": "diacritico: articulacion distal flexionada",
    "deg": "° = redondeado (tension muscular reducida)",
    "sep": "separado (los dedos seleccionados se separan en la articulacion metacarpo-proximal)",
    "crz": "cruzado",
    "apilR": "apilado radial",
    "apilC": "apilado cubital",
    "apil": "apilado (el original no especifica el lado)",
    "NSAb-": "dedos no seleccionados abajo (fuera del plano de la palma)",
    "a": "pulgar alineado (Po-)",
    "o": "pulgar opuesto (Po+)",
    "c+": "contacto fonologicamente relevante entre pulgar y dedo seleccionado",
    "y-": "contacto con una parte distinta de la yema",
    "ps": "pulgar sujeto (restringido)",
    "ds": "dedo sujeto (restringido)"
  },
